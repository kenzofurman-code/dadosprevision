# Configuracoes do Servidor Dados Prevision na VPS

PORT=3000
# Banco de Dados PostgreSQL (se rodando via Docker)
POSTGRES_DB=dadosprevision
POSTGRES_USER=postgres
# Obrigatoria. O Docker Compose falha se este valor ficar vazio.
POSTGRES_PASSWORD=

# Chaves de Integracao com a API da Prevision
PREVISION_API_KEY=sua_chave_graphql_aqui
PREVISION_REST_TOKEN=seu_token_rest_aqui

# Regra de Sincronizacao Automatica (Cron)
# '0 20 * * *' = Todo dia as 20:00 (1x ao dia)
CRON_SYNC_SCHEDULE=0 20 * * *

# Robo de extracao do Mega ERP (servico "mega", ver mega/deploy/DEPLOY_VPS.md)
MEGA_USUARIO=
MEGA_SENHA=
# Padrao: 00:00 todo dia — fora de qualquer horario de uso do ERP.
CRON_SCHEDULE_MEGA=0 0 * * *
# Checagem e re-tentativa (retry) apenas das obras/relatorios que falharam na madrugada.
# Roda as 06:30 e de novo ao meio-dia. Cada retry tem janela de 90 min (acaba as 08:00 e
# as 13:30): para de abrir trabalho novo aos RETRY_TEMPO_MAX_MINUTOS (80) e e encerrado aos +10.
CRON_SCHEDULE_MEGA_RETRY=30 6 * * *
CRON_SCHEDULE_MEGA_RETRY_ALMOCO=0 12 * * *
RETRY_TEMPO_MAX_MINUTOS=80

# Portal de Aprovacoes Approvo Mega ERP
APPROVO_USUARIO=
APPROVO_SENHA=
# Padrao: 22:00 todo dia — antes dos relatorios noturnos do Mega (execucao rapida ~1-2 min).
CRON_SCHEDULE_APPROVO=0 22 * * *

# Diário de Obra (API externa). Token: sistema do Diário > Cadastros > Empresa > Gerar token.
TOKEN_DIARIO=
# Padrão: 21:00 todo dia. Primeira carga leva ~20 min (limite de 150 req/min); as seguintes são incrementais.
CRON_SCHEDULE_DIARIO=0 21 * * *


# INCC-DI (Painel 9 - orçamento reajustado). Fonte: API pública do Banco Central, série SGS 192. Padrão: 07:00 todo dia.
CRON_SCHEDULE_INCC=0 7 * * *
