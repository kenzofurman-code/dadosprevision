# Configuracoes do Servidor Dados Prevision na VPS

PORT=3000
# Banco de Dados PostgreSQL (se rodando via Docker)
POSTGRES_DB=dadosprevision
POSTGRES_USER=postgres
# Obrigatoria. O Docker Compose falha se este valor ficar vazio.
POSTGRES_PASSWORD=

# Chaves de Integracao com a API da Prevision
PREVISION_API_KEY=sua_chave_graphql_aqui
PREVISION_REST_TOKEN=seu_token_rest_aqui

# Regra de Sincronizacao Automatica (Cron)
# '0 6,18 * * *' = Todo dia as 06:00 e 18:00
CRON_SYNC_SCHEDULE=0 6,18 * * *
